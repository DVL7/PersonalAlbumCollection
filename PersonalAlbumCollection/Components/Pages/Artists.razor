@* Artists.razor *@

@page "/artists"
@rendermode InteractiveServer
@using PersonalAlbumCollection.DTOs
@using PersonalAlbumCollection.Models.Enums
@inject PersonalAlbumCollection.Services.Interfaces.IArtistService ArtistService
@inject ICurrentUserService CurrentUser

@* AuthGuard przekierowuje niezalogowanych użytkowników na stronę logowania *@
<AuthGuard>
    @* Nagłówek strony *@
    <div class="pac-page-header">
        <div>
            <p class="pac-eyebrow">Biblioteka</p>
            <h2>Artyści</h2>
        </div>
    </div>

    @* Formularz dodawania nowego artysty — panel inline z polem nazwy, typem i krajem *@
    <div class="pac-panel pac-inline-form pac-inline-form-wrap">
        <input class="pac-input" placeholder="Nazwa artysty" @bind="newDto.Name" />
        <select class="pac-input" style="max-width:160px" @bind="newDto.ArtistType">
            @foreach (var type in Enum.GetValues<ArtistType>())
            {
                <option value="@type">@type</option>
            }
        </select>
        <input class="pac-input" placeholder="Kraj (opcjonalnie)" @bind="newDto.Country" />
        <button class="pac-btn pac-btn-primary" @onclick="CreateArtist">+ Dodaj artystę</button>
    </div>

    @* Pasek wyszukiwania — filtruje listę artystów po nazwie w czasie rzeczywistym *@
    <div class="pac-toolbar">
        <input class="pac-input" placeholder="Szukaj artysty" @bind="search" @bind:event="oninput" @bind:after="LoadArtists" />
    </div>

    @* Komunikat błędu lub sukcesu operacji *@
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="pac-alert @(isError ? "pac-alert-danger" : "")">@message</div>
    }

    @* Tabela artystów z edycją inline *@
    <div class="pac-table-panel">
        <table class="pac-table">
            <thead>
                <tr>
                    <th>Nazwa</th>
                    <th>Typ</th>
                    <th>Kraj</th>
                    <th>Albumy</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var artist in artists)
                {
                    <tr>
                        @* Wiersz w trybie edycji — pola zastępują komórki z danymi *@
                        @if (editingId == artist.Id)
                        {
                            <td><input class="pac-input pac-input-inline" @bind="editDto.Name" /></td>
                            <td>
                                <select class="pac-input pac-input-inline" @bind="editDto.ArtistType">
                                    @foreach (var type in Enum.GetValues<ArtistType>())
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                            </td>
                            <td><input class="pac-input pac-input-inline" @bind="editDto.Country" /></td>
                            <td>@artist.AlbumCount</td>
                            <td class="pac-table-actions">
                                <button class="pac-btn pac-btn-small pac-btn-outline" @onclick="() => SaveEdit(artist.Id)">Zapisz</button>
                                <button class="pac-btn pac-btn-small pac-btn-ghost" @onclick="CancelEdit">Anuluj</button>
                            </td>
                        }
                        @* Wiersz w trybie podglądu — dane z przyciskami edycji i usunięcia *@
                        else
                        {
                            <td>@artist.Name</td>
                            <td>@artist.ArtistType</td>
                            <td>@(artist.Country ?? "—")</td>
                            <td>@artist.AlbumCount</td>
                            <td class="pac-table-actions">
                                <button class="pac-btn pac-btn-small pac-btn-ghost" @onclick="() => StartEdit(artist)">Edytuj</button>
                                <button class="pac-btn pac-btn-small pac-btn-danger" @onclick="() => RequestDelete(artist.Id, artist.Name)">Usuń</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Dialog potwierdzenia usunięcia artysty *@
    <ConfirmDialog
        IsVisible="confirmVisible"
        Title="Usuń artystę"
        Message="@($"Czy na pewno chcesz usunąć \"{confirmArtistName}\"? Tej operacji nie można cofnąć.")"
        ConfirmLabel="Usuń"
        OnConfirm="ConfirmDelete"
        OnCancel="CancelDelete" />
</AuthGuard>

@code {
    // Lista artystów pobrana z serwisu
    private List<ArtistDto> artists = new();

    // Fraza wyszukiwania do filtrowania listy
    private string? search;

    // Komunikat wyniku operacji i flaga błędu
    private string? message;
    private bool isError;

    // DTO dla formularza dodawania nowego artysty
    private ArtistCreateDto newDto = new();

    // Id artysty aktualnie edytowanego inline oraz jego DTO edycji
    private int? editingId;
    private ArtistUpdateDto editDto = new();

    // Stan dialogu potwierdzenia usunięcia
    private bool confirmVisible;
    private int? pendingDeleteId;
    private string confirmArtistName = string.Empty;

    /// <summary>
    /// Ładuje listę artystów przy inicjalizacji komponentu.
    /// Pomija ładowanie gdy użytkownik nie jest zalogowany (obsługiwane przez AuthGuard).
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsLoggedIn) return;
        await LoadArtists();
    }

    /// <summary>
    /// Pobiera listę artystów z uwzględnieniem aktualnej frazy wyszukiwania.
    /// </summary>
    private async Task LoadArtists() =>
        artists = await ArtistService.GetAllAsync(search);

    /// <summary>
    /// Tworzy nowego artystę przez serwis, czyści formularz i odświeża listę.
    /// </summary>
    private async Task CreateArtist()
    {
        await RunAsync(async () =>
        {
            await ArtistService.CreateAsync(newDto);
            newDto = new ArtistCreateDto();
            await LoadArtists();
        });
    }

    /// <summary>
    /// Włącza tryb edycji inline dla wybranego artysty.
    /// Wypełnia editDto aktualnymi danymi artysty i czyści poprzedni komunikat.
    /// </summary>
    /// <param name="artist">Artysta do edycji.</param>
    private void StartEdit(ArtistDto artist)
    {
        editingId = artist.Id;
        editDto = new ArtistUpdateDto
        {
            Name = artist.Name,
            ArtistType = artist.ArtistType,
            Country = artist.Country
        };
        message = null;
    }

    /// <summary>
    /// Anuluje tryb edycji inline bez zapisywania zmian.
    /// </summary>
    private void CancelEdit() => editingId = null;

    /// <summary>
    /// Zapisuje zmiany edytowanego artysty przez serwis i odświeża listę.
    /// </summary>
    /// <param name="id">Id artysty do zaktualizowania.</param>
    private async Task SaveEdit(int id)
    {
        await RunAsync(async () =>
        {
            await ArtistService.UpdateAsync(id, editDto);
            editingId = null;
            await LoadArtists();
        });
    }

    /// <summary>
    /// Inicjuje proces usuwania — ustawia nazwę artysty i otwiera dialog potwierdzenia.
    /// </summary>
    /// <param name="id">Id artysty do usunięcia.</param>
    /// <param name="name">Nazwa artysty wyświetlana w dialogu potwierdzenia.</param>
    private void RequestDelete(int id, string name)
    {
        pendingDeleteId = id;
        confirmArtistName = name;
        confirmVisible = true;
    }

    /// <summary>
    /// Wykonuje usunięcie artysty po potwierdzeniu przez użytkownika.
    /// Odświeża listę artystów po operacji.
    /// </summary>
    private async Task ConfirmDelete()
    {
        confirmVisible = false;
        if (pendingDeleteId is null) return;
        await RunAsync(async () =>
        {
            await ArtistService.DeleteAsync(pendingDeleteId.Value);
            pendingDeleteId = null;
            await LoadArtists();
        });
    }

    /// <summary>
    /// Anuluje operację usuwania i zamyka dialog potwierdzenia.
    /// </summary>
    private void CancelDelete()
    {
        confirmVisible = false;
        pendingDeleteId = null;
    }

    /// <summary>
    /// Pomocnicza metoda opakowująca wywołania serwisu w obsługę błędów.
    /// Czyści komunikat przed wykonaniem akcji i wyświetla wyjątek gdy wystąpi błąd.
    /// </summary>
    /// <param name="action">Akcja asynchroniczna do wykonania.</param>
    private async Task RunAsync(Func<Task> action)
    {
        message = null;
        isError = false;
        try { await action(); }
        catch (Exception ex) { message = ex.Message; isError = true; }
    }
}
