@* Settings.razor *@

@page "/settings"
@rendermode InteractiveServer
@using PersonalAlbumCollection.DTOs
@inject PersonalAlbumCollection.Services.Interfaces.IAuthService AuthService
@inject ICurrentUserService CurrentUser
@inject NavigationManager Navigation
@implements IDisposable

@* AuthGuard przekierowuje niezalogowanych użytkowników na stronę logowania *@
<AuthGuard>
    @* Nagłówek strony *@
    <div class="pac-page-header">
        <div>
            <p class="pac-eyebrow">Konto</p>
            <h2>Ustawienia</h2>
        </div>
    </div>

    @* Globalny komunikat sukcesu — widoczny po pomyślnym wykonaniu dowolnej operacji *@
    @if (!string.IsNullOrWhiteSpace(globalSuccess))
    {
        <div class="pac-alert pac-alert-success">@globalSuccess</div>
    }

    @* Sekcja: zmiana nazwy użytkownika *@
    <div class="pac-settings-section">
        <div class="pac-settings-section-header">
            <h3>Nazwa użytkownika</h3>
            <p class="pac-muted">Aktualna: <strong>@CurrentUser.UserName</strong></p>
        </div>
        <div class="pac-form-card pac-settings-card">
            <div class="pac-form-field">
                <label class="pac-label" for="newUserName">Nowa nazwa użytkownika</label>
                <input id="newUserName" class="pac-input" @bind="newUserName" />
            </div>
            @* Komunikat błędu zmiany nazwy użytkownika *@
            @if (!string.IsNullOrWhiteSpace(userNameError))
            {
                <div class="pac-alert pac-alert-danger">@userNameError</div>
            }
            <div class="pac-form-actions">
                @* Przycisk otwiera dialog potwierdzenia zamiast od razu wykonywać operację *@
                <button class="pac-btn pac-btn-outline" @onclick="() => showUserNameConfirm = true">
                    Zmień nazwę użytkownika
                </button>
            </div>
        </div>
    </div>

    @* Sekcja: zmiana adresu e-mail *@
    <div class="pac-settings-section">
        <div class="pac-settings-section-header">
            <h3>Adres e-mail</h3>
        </div>
        <div class="pac-form-card pac-settings-card">
            <div class="pac-form-field">
                <label class="pac-label" for="newEmail">Nowy adres e-mail</label>
                <input id="newEmail" class="pac-input" type="email" @bind="newEmail" />
            </div>
            @* Komunikat błędu zmiany e-maila *@
            @if (!string.IsNullOrWhiteSpace(emailError))
            {
                <div class="pac-alert pac-alert-danger">@emailError</div>
            }
            <div class="pac-form-actions">
                <button class="pac-btn pac-btn-outline" @onclick="() => showEmailConfirm = true">
                    Zmień adres e-mail
                </button>
            </div>
        </div>
    </div>

    @* Sekcja: zmiana hasła — wymaga podania obecnego hasła i potwierdzenia nowego *@
    <div class="pac-settings-section">
        <div class="pac-settings-section-header">
            <h3>Hasło</h3>
        </div>
        <div class="pac-form-card pac-settings-card">
            <div class="pac-form-field">
                <label class="pac-label" for="currentPassword">Obecne hasło</label>
                <input id="currentPassword" class="pac-input" type="password" @bind="currentPassword" />
            </div>
            <div class="pac-form-field">
                <label class="pac-label" for="newPassword">Nowe hasło</label>
                <input id="newPassword" class="pac-input" type="password" @bind="newPassword" />
            </div>
            <div class="pac-form-field">
                <label class="pac-label" for="confirmPassword">Potwierdź nowe hasło</label>
                <input id="confirmPassword" class="pac-input" type="password" @bind="confirmPassword" />
            </div>
            @* Komunikat błędu zmiany hasła (w tym niezgodność haseł) *@
            @if (!string.IsNullOrWhiteSpace(passwordError))
            {
                <div class="pac-alert pac-alert-danger">@passwordError</div>
            }
            <div class="pac-form-actions">
                <button class="pac-btn pac-btn-outline" @onclick="() => showPasswordConfirm = true">
                    Zmień hasło
                </button>
            </div>
        </div>
    </div>

    @* Sekcja: strefa niebezpieczna — trwałe usunięcie konta i wszystkich danych *@
    <div class="pac-settings-section pac-settings-danger-zone">
        <div class="pac-settings-section-header">
            <h3>Strefa niebezpieczna</h3>
            <p class="pac-muted">Ta operacja jest nieodwracalna.</p>
        </div>
        <div class="pac-form-card pac-settings-card">
            <div class="pac-form-field">
                <label class="pac-label" for="deletePassword">Potwierdź hasło, aby usunąć konto</label>
                <input id="deletePassword" class="pac-input" type="password" @bind="deletePassword" />
            </div>
            @* Komunikat błędu usuwania konta *@
            @if (!string.IsNullOrWhiteSpace(deleteError))
            {
                <div class="pac-alert pac-alert-danger">@deleteError</div>
            }
            <div class="pac-form-actions">
                <button class="pac-btn pac-btn-danger" @onclick="() => showDeleteConfirm = true">
                    Usuń konto
                </button>
            </div>
        </div>
    </div>

    @* Dialogi potwierdzenia dla każdej z operacji *@

    <ConfirmDialog
        IsVisible="showUserNameConfirm"
        Title="Zmień nazwę użytkownika"
        Message="@($"Czy na pewno chcesz zmienić nazwę użytkownika na \"{newUserName}\"?")"
        ConfirmLabel="Tak, zmień"
        OnConfirm="ChangeUserName"
        OnCancel="() => showUserNameConfirm = false" />

    <ConfirmDialog
        IsVisible="showEmailConfirm"
        Title="Zmień adres e-mail"
        Message="@($"Czy na pewno chcesz zmienić adres e-mail na \"{newEmail}\"?")"
        ConfirmLabel="Tak, zmień"
        OnConfirm="ChangeEmail"
        OnCancel="() => showEmailConfirm = false" />

    <ConfirmDialog
        IsVisible="showPasswordConfirm"
        Title="Zmień hasło"
        Message="Czy na pewno chcesz zmienić hasło?"
        ConfirmLabel="Tak, zmień"
        OnConfirm="ChangePassword"
        OnCancel="() => showPasswordConfirm = false" />

    <ConfirmDialog
        IsVisible="showDeleteConfirm"
        Title="Usuń konto"
        Message="Spowoduje to trwałe usunięcie Twojego konta i wszystkich danych — albumów, artystów i gatunków. Tej operacji nie można cofnąć."
        ConfirmLabel="Usuń moje konto"
        OnConfirm="DeleteAccount"
        OnCancel="() => showDeleteConfirm = false" />
</AuthGuard>

@code {
    // Sekcja: nazwa użytkownika
    private string newUserName = string.Empty;
    private string? userNameError;
    private bool showUserNameConfirm;

    // Sekcja: e-mail
    private string newEmail = string.Empty;
    private string? emailError;
    private bool showEmailConfirm;

    // Sekcja: hasło
    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string? passwordError;
    private bool showPasswordConfirm;

    // Sekcja: usunięcie konta
    private string deletePassword = string.Empty;
    private string? deleteError;
    private bool showDeleteConfirm;

    // Globalny komunikat sukcesu wyświetlany po każdej pomyślnej operacji
    private string? globalSuccess;

    /// <summary>
    /// Subskrybuje zdarzenie zmiany stanu użytkownika,
    /// aby wyświetlana nazwa użytkownika była zawsze aktualna.
    /// Pomija inicjalizację gdy użytkownik nie jest zalogowany (obsługiwane przez AuthGuard).
    /// </summary>
    protected override void OnInitialized()
    {
        if (!CurrentUser.IsLoggedIn) return;
        CurrentUser.OnChange += StateHasChanged;
    }

    /// <summary>
    /// Zmienia nazwę użytkownika przez AuthService.
    /// Wyświetla komunikat błędu gdy operacja się nie powiedzie,
    /// lub globalny komunikat sukcesu i czyści pole formularza przy powodzeniu.
    /// </summary>
    private async Task ChangeUserName()
    {
        showUserNameConfirm = false;
        userNameError = null;
        globalSuccess = null;

        var result = await AuthService.ChangeUserNameAsync(CurrentUser.UserId!.Value, newUserName);
        if (!result.Success)
        {
            userNameError = result.ErrorMessage;
            return;
        }

        newUserName = string.Empty;
        globalSuccess = "Nazwa użytkownika została zmieniona.";
    }

    /// <summary>
    /// Zmienia adres e-mail przez AuthService.
    /// Wyświetla komunikat błędu gdy operacja się nie powiedzie,
    /// lub globalny komunikat sukcesu i czyści pole formularza przy powodzeniu.
    /// </summary>
    private async Task ChangeEmail()
    {
        showEmailConfirm = false;
        emailError = null;
        globalSuccess = null;

        var result = await AuthService.ChangeEmailAsync(CurrentUser.UserId!.Value, newEmail);
        if (!result.Success)
        {
            emailError = result.ErrorMessage;
            return;
        }

        newEmail = string.Empty;
        globalSuccess = "Adres e-mail został zmieniony.";
    }

    /// <summary>
    /// Zmienia hasło przez AuthService.
    /// Najpierw weryfikuje zgodność nowego hasła z potwierdzeniem.
    /// Wyświetla komunikat błędu gdy operacja się nie powiedzie,
    /// lub globalny komunikat sukcesu i czyści pola formularza przy powodzeniu.
    /// </summary>
    private async Task ChangePassword()
    {
        showPasswordConfirm = false;
        passwordError = null;
        globalSuccess = null;

        // Walidacja zgodności nowego hasła z potwierdzeniem po stronie klienta
        if (newPassword != confirmPassword)
        {
            passwordError = "Hasła nie są zgodne.";
            return;
        }

        var result = await AuthService.ChangePasswordAsync(CurrentUser.UserId!.Value, currentPassword, newPassword);
        if (!result.Success)
        {
            passwordError = result.ErrorMessage;
            return;
        }

        currentPassword = string.Empty;
        newPassword = string.Empty;
        confirmPassword = string.Empty;
        globalSuccess = "Hasło zostało zmienione.";
    }

    /// <summary>
    /// Usuwa konto użytkownika przez AuthService i przekierowuje na /auth/logout.
    /// Wyświetla komunikat błędu gdy operacja się nie powiedzie (np. błędne hasło).
    /// forceLoad: true wymusza pełne przeładowanie strony, aby wyczyścić stan Blazora.
    /// </summary>
    private async Task DeleteAccount()
    {
        showDeleteConfirm = false;
        deleteError = null;

        var result = await AuthService.DeleteAccountAsync(CurrentUser.UserId!.Value, deletePassword);
        if (!result.Success)
        {
            deleteError = result.ErrorMessage;
            return;
        }

        Navigation.NavigateTo("/auth/logout", forceLoad: true);
    }

    /// <summary>
    /// Usuwa subskrypcję zdarzenia OnChange przy niszczeniu komponentu,
    /// aby uniknąć wycieków pamięci.
    /// </summary>
    public void Dispose()
    {
        CurrentUser.OnChange -= StateHasChanged;
    }
}
