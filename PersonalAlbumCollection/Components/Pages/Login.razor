@* Login.razor *@

@page "/login"
@layout AuthLayout
@rendermode InteractiveServer
@inject ICurrentUserService CurrentUser
@inject NavigationManager Navigation

@* Karta formularza logowania *@
<div class="pac-auth-card">
    <p class="pac-eyebrow">Konto</p>
    <h2>Logowanie</h2>

    @* Komunikat sukcesu — widoczny po przekierowaniu z rejestracji (?registered=1) *@
    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="pac-alert pac-alert-success">@SuccessMessage</div>
    }

    @* Formularz logowania — wysyła POST do /auth/login.
       data-enhance="false" wyłącza enhanced navigation Blazora dla tego formularza.
       AntiforgeryToken chroni przed atakami CSRF. *@
    <form method="post" action="/auth/login" @formname="login-form" data-enhance="false">
        <AntiforgeryToken />
        <div class="pac-form-field">
            <label class="pac-label" for="login">Login lub e-mail</label>
            <input id="login" class="pac-input" name="login" autocomplete="username" />
        </div>
        <div class="pac-form-field">
            <label class="pac-label" for="password">Hasło</label>
            <input id="password" class="pac-input" type="password" name="password" autocomplete="current-password" />
        </div>
        <button class="pac-btn pac-btn-primary pac-btn-wide" type="submit">Zaloguj się</button>
    </form>

    @* Komunikat błędu — widoczny gdy serwer zwróci ?error w URL *@
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="pac-alert pac-alert-danger">@ErrorMessage</div>
    }

    @* Link do rejestracji *@
    <p class="pac-auth-footer">Nie masz konta? <a href="/register" class="pac-auth-link">Zarejestruj się</a>.</p>
</div>

@code {
    /// <summary>
    /// Parametr z URL — obecność wartości oznacza błąd logowania.
    /// </summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    /// <summary>
    /// Parametr z URL — obecność wartości oznacza pomyślną rejestrację.
    /// </summary>
    [SupplyParameterFromQuery(Name = "registered")]
    public string? Registered { get; set; }

    /// <summary>
    /// Komunikat błędu logowania — zwraca treść gdy parametr Error jest obecny w URL.
    /// </summary>
    private string? ErrorMessage => Error is null ? null : "Nieprawidłowy login lub hasło.";

    /// <summary>
    /// Komunikat sukcesu po rejestracji — zwraca treść gdy parametr Registered jest obecny w URL.
    /// </summary>
    private string? SuccessMessage => Registered is null ? null : "Konto utworzone! Możesz się teraz zalogować.";

    /// <summary>
    /// Przy inicjalizacji sprawdza, czy użytkownik jest już zalogowany —
    /// jeśli tak, przekierowuje na /albums.
    /// </summary>
    protected override void OnInitialized()
    {
        if (CurrentUser.IsLoggedIn)
            Navigation.NavigateTo("/albums", replace: true);
    }
}
